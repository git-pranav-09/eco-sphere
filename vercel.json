{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "{db/schema.sql,private/admin/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/healthz", "destination": "/api/index.js" },
    { "source": "/admin/login", "destination": "/api/index.js" },
    { "source": "/admin/admin.css", "destination": "/api/index.js" },
    { "source": "/admin/login.js", "destination": "/api/index.js" },
    { "source": "/admin/admin.js", "destination": "/api/index.js" },
    { "source": "/admin/", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" }
  ]
}
